{
  "name": "stanbic-fx-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Stanbic Bank FX & Cross-Border Transfer Portal — GitHub Enterprise, GHAS & Copilot demonstration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
